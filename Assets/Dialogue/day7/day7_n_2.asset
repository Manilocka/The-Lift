  lines:
  - speakerName: "\u041F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u0438\u0439"
    text: "\u0412\u044B \u2014 \u0441\u043E\u0441\u0435\u0434\u043A\u0430 \u041D\u0438\u043D\u044B
      \u0410\u0440\u043A\u0430\u0434\u044C\u0435\u0432\u043D\u044B? "
    isPlayer: 0
    isThought: 0
    choices: []
    hasImpact: 0
  - speakerName: 
    text: "\u0414\u0430. \u0427\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C? "
    isPlayer: 1
    isThought: 0
    choices: []
    hasImpact: 0
  - speakerName: "\u041F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u0438\u0439"
    text: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0434\u043D\u0438
      \u0432\u044B \u043D\u0438\u0447\u0435\u0433\u043E \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0433\u043E
      \u043D\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u043B\u0438?"
    isPlayer: 0
    isThought: 0
    choices: []
    hasImpact: 0
  - speakerName: "\u041F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u0438\u0439"
    text: " \u0417\u0432\u0443\u043A\u0438, \u0437\u0430\u043F\u0430\u0445\u0438,
      \u043F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
      \u043B\u044E\u0434\u0435\u0439? "
    isPlayer: 0
    isThought: 0
    choices: []
    hasImpact: 0
  - speakerName: 
    text: 
    isPlayer: 1
    isThought: 0
    choices:
    - choiceText: "\u0412\u0440\u043E\u0434\u0435 \u0431\u044B \u0441\u043B\u044B\u0448\u0430\u043B\u0430"
      dialogueLines:
      - speakerName: 
        text: "\u0421\u043E \u043F\u043E\u0437\u0430\u0432\u0447\u0435\u0440\u0430
          \u043D\u0430 \u044D\u0442\u0430\u0436\u0435 \u0431\u044B\u043B\u0438 \u0437\u0432\u0443\u043A\u0438,
          \u0431\u0443\u0434\u0442\u043E \u0441\u043E\u0431\u0430\u043A\u0430 \u0434\u0432\u0435\u0440\u044C
          \u0446\u0430\u0440\u0430\u043F\u0430\u0435\u0442."
        isPlayer: 1
        isThought: 0
        choices: []
        hasImpact: 0
      - speakerName: "\u041F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u0438\u0439"
        text: "\u0421\u043E\u0431\u0430\u043A\u0430?"
        isPlayer: 0
        isThought: 0
        choices: []
        hasImpact: 0
      - speakerName: 
        text: "\u0414\u0430. \u041E\u043D\u0438 \u0431\u044B\u043B\u0438 \u0441\u043B\u0430\u0431\u044B\u0435."
        isPlayer: 1
        isThought: 0
        choices: []
        hasImpact: 0
      - speakerName: "\u041F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u0438\u0439"
        text: "\u0412\u0440\u0430\u0447 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B,
          \u0447\u0442\u043E \u043E\u043D\u0430 \u0443\u043C\u0435\u0440\u043B\u0430
          \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0447\u0430\u0441\u043E\u0432
          \u043D\u0430\u0437\u0430\u0434."
        isPlayer: 0
        isThought: 0
        choices: []
        hasImpact: 0
      - speakerName: 
        text: "\u0421\u043E\u0431\u0430\u043A\u0430?"
        isPlayer: 1
        isThought: 0
        choices: []
        hasImpact: 0
      - speakerName: "\u041F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u0438\u0439"
        text: "\u041D\u0438\u043D\u0430 \u0410\u0440\u043A\u0430\u0434\u044C\u0435\u0432\u043D\u0430.  "
        isPlayer: 0
        isThought: 0
        choices: []
        hasImpact: 0
      - speakerName: 
        text: ...
        isPlayer: 1
        isThought: 0
        choices: []
        hasImpact: 0
      - speakerName: "\u041F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u0438\u0439"
        text: "\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043E\u043D\u0430
          \u043F\u044B\u0442\u0430\u043B\u0430\u0441\u044C \u043F\u043E\u0437\u0432\u0430\u0442\u044C
          \u043D\u0430 \u043F\u043E\u043C\u043E\u0449\u044C. "
        isPlayer: 0
        isThought: 0
        choices: []
        hasImpact: 0
      - speakerName: 
        text: ...
        isPlayer: 1
        isThought: 0
        choices: []
        hasImpact: 0
      - speakerName: "\u041F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u0438\u0439"
        text: "\u0412\u0438\u0434\u0438\u043C\u043E, \u0434\u0430\u0436\u0435 \u043D\u0430
          \u043A\u0440\u0438\u043A \u0438\u043B\u0438 \u0443\u0434\u0430\u0440 \u0435\u0439
          \u043D\u0435 \u0445\u0432\u0430\u0442\u0438\u043B\u043E \u0441\u0438\u043B. "
        isPlayer: 0
        isThought: 0
        choices: []
        hasImpact: 0
      sceneToLoad: 
    - choiceText: "\u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0441\u043B\u044B\u0448\u0430\u043B\u0430"
      dialogueLines:
      - speakerName: 
        text: "\u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0441\u043B\u044B\u0448\u0430\u043B\u0430. "
        isPlayer: 1
        isThought: 0
        choices: []
        hasImpact: 0
      - speakerName: "\u041F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u0438\u0439"
        text: "\u0412\u044B \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0438
          \u0434\u043E\u043C\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
          \u0434\u043D\u0438? "
        isPlayer: 0
        isThought: 0
        choices: []
        hasImpact: 0
      - speakerName: 
        text: "\u0420\u0430\u0437\u0432\u0435 \u0447\u0442\u043E \u0445\u043E\u0434\u0438\u043B\u0430
          \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0443."
        isPlayer: 1
        isThought: 0
        choices: []
        hasImpact: 0
      - speakerName: "\u041F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u0438\u043A\u0439"
        text: "\u0412\u0430\u0448\u0430 \u0441\u043E\u0441\u0435\u0434\u043A\u0430
          \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0434\u043D\u0438
          \u0441\u043B\u044B\u0448\u0430\u043B\u0430 \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0435
          \u0437\u0432\u0443\u043A\u0438. "
        isPlayer: 0
        isThought: 0
        choices: []
        hasImpact: 0
      - speakerName: 
        text: "\u041D\u0435\u0434\u0430\u0432\u043D\u043E \u043D\u0430 \u044D\u0442\u0430\u0436\u0435
          \u0431\u044B\u043B\u0438 \u0437\u0432\u0443\u043A\u0438, \u0431\u0443\u0434\u0442\u043E
          \u0441\u043E\u0431\u0430\u043A\u0430 \u0434\u0432\u0435\u0440\u044C \u0446\u0430\u0440\u0430\u043F\u0430\u0435\u0442. "
        isPlayer: 1
        isThought: 0
        choices: []
        hasImpact: 0
      - speakerName: "\u041F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u0438\u0439"
        text: "\u0421\u043E\u0431\u0430\u043A\u0430?"
        isPlayer: 0
        isThought: 0
        choices: []
        hasImpact: 0
      - speakerName: 
        text: "\u0414\u0430. \u041E\u043D\u0438 \u0431\u044B\u043B\u0438 \u0441\u043B\u0430\u0431\u044B\u0435."
        isPlayer: 1
        isThought: 0
        choices: []
        hasImpact: 0
      - speakerName: "\u041F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u0438\u0439"
        text: "\u0412\u0440\u0430\u0447 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B,
          \u0447\u0442\u043E \u043E\u043D\u0430 \u0443\u043C\u0435\u0440\u043B\u0430
          \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0447\u0430\u0441\u043E\u0432
          \u043D\u0430\u0437\u0430\u0434. "
        isPlayer: 0
        isThought: 0
        choices: []
        hasImpact: 0
      - speakerName: 
        text: "\u0421\u043E\u0431\u0430\u043A\u0430? "
        isPlayer: 1
        isThought: 0
        choices: []
        hasImpact: 0
      - speakerName: "\u041F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u0438\u0439"
        text: "\u041D\u0438\u043D\u0430 \u0410\u0440\u043A\u0430\u0434\u044C\u0435\u0432\u043D\u0430.  "
        isPlayer: 0
        isThought: 0
        choices: []
        hasImpact: 0
      - speakerName: 
        text: ...
        isPlayer: 1
        isThought: 0
        choices: []
        hasImpact: 0
      - speakerName: "\u041F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u0438\u0439"
        text: "\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043E\u043D\u0430
          \u043F\u044B\u0442\u0430\u043B\u0430\u0441\u044C \u043F\u043E\u0437\u0432\u0430\u0442\u044C
          \u043D\u0430 \u043F\u043E\u043C\u043E\u0449\u044C. "
        isPlayer: 0
        isThought: 0
        choices: []
        hasImpact: 0
      - speakerName: 
        text: ...
        isPlayer: 1
        isThought: 0
        choices: []
        hasImpact: 0
      - speakerName: "\u041F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u0438\u0439"
        text: "\u0412\u0438\u0434\u0438\u043C\u043E, \u0434\u0430\u0436\u0435 \u043D\u0430
          \u043A\u0440\u0438\u043A \u0438\u043B\u0438 \u0443\u0434\u0430\u0440 \u0435\u0439
          \u043D\u0435 \u0445\u0432\u0430\u0442\u0438\u043B\u043E \u0441\u0438\u043B."
        isPlayer: 0
        isThought: 0
        choices: []
        hasImpact: 0
