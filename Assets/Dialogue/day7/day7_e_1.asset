  m_Script: {fileID: 11500000, guid: 5f678bb307374424aa5463d934b9f5e2, type: 3}
  m_Name: day7_e_1
  m_EditorClassIdentifier: 
  lines:
  - speakerName: "\u0418\u0432\u0430\u043D\u043E\u0432"
    text: "\u0421\u043B\u044B\u0448\u0430\u043B\u0438, \u041D\u0438\u043D\u0430 \u0410\u0440\u043A\u0430\u0434\u044C\u0435\u0432\u043D\u0430
      \u0441 8-\u043E\u0433\u043E \u0443\u043C\u0435\u0440\u043B\u0430? "
    isPlayer: 0
    isThought: 0
    choices: []
    hasImpact: 1
  - speakerName: 
    text: "\u0414\u0430, \u043D\u043E\u0447\u044C\u044E \u043C\u0435\u043D\u044F
      \u0434\u043E\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B\u0438."
    isPlayer: 1
    isThought: 0
    choices: []
    hasImpact: 1
  - speakerName: "\u0418\u0432\u0430\u043D\u043E\u0432"
    text: "\u0427\u0442\u043E \u0442\u0432\u043E\u0440\u0438\u0442\u0441\u044F\u2026 "
    isPlayer: 0
    isThought: 0
    choices: []
    hasImpact: 1
  - speakerName: 
    text: "\u2026"
    isPlayer: 1
    isThought: 0
    choices: []
    hasImpact: 1
  - speakerName: "\u0418\u0432\u0430\u043D\u043E\u0432"
    text: "\u0422\u0430\u043A, \u043F\u043E\u0433\u043E\u0434\u0438-\u043A\u0430. "
    isPlayer: 0
    isThought: 0
    choices: []
    hasImpact: 1
  - speakerName: "\u0418\u0432\u0430\u043D\u043E\u0432"
    text: "\u041D\u0443 \u0438 \u043A\u0442\u043E \u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u044D\u0442\u0438 \u043A\u0430\u0440\u0430\u043A\u0443\u043B\u0438?"
    isPlayer: 0
    isThought: 0
    choices: []
    hasImpact: 1
  - speakerName: "\u0418\u0432\u0430\u043D\u043E\u0432"
    text: "\u041E\u043F\u044F\u0442\u044C \u044D\u0442\u0438 \u0448\u0430\u043B\u043E\u043F\u0430\u0438
      \u0441 7-\u0433\u043E \u044D\u0442\u0430\u0436\u0430! "
    isPlayer: 0
    isThought: 0
    choices: []
    hasImpact: 1
  - speakerName: "\u0418\u0432\u0430\u043D\u043E\u0432"
    text: " \u041E\u043F\u044F\u0442\u044C \u043A\u0442\u043E-\u0442\u043E \u0438\u0437
      \u044D\u0442\u0438\u0445 \u0442\u0430\u0442\u0430\u0440\u0447\u0430\u0442!"
    isPlayer: 0
    isThought: 0
    choices: []
    hasImpact: 1
  - speakerName: "\u0418\u0432\u0430\u043D\u043E\u0432"
    text: "\u0420\u0443\u043A\u0438 \u0431\u044B \u043F\u043E\u043E\u0442\u0440\u044B\u0432\u0430\u0442\u044C
      \u0437\u0430 \u0442\u0430\u043A\u0438\u0435 \u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0430!"
    isPlayer: 0
    isThought: 0
    choices: []
    hasImpact: 1
  - speakerName: 
    text: "\u041D\u043E \u044D\u0442\u043E \u0442\u043E\u0447\u043D\u043E \u0431\u044B\u043B
      \u043C\u0430\u043B\u044C\u0447\u0438\u043A \u0414\u0438\u043C\u0430"
    isPlayer: 1
    isThought: 1
    choices: []
    hasImpact: 1
  - speakerName: 
    text: "\u042D\u0442\u043E \u043D\u0435 \u043E\u043D\u0438."
    isPlayer: 1
    isThought: 0
    choices: []
    hasImpact: 1
  - speakerName: "\u0418\u0432\u0430\u043D\u043E\u0432"
    text: "\u0410 \u043A\u0442\u043E \u0436\u0435 \u0442\u043E\u0433\u0434\u0430? "
    isPlayer: 0
    isThought: 0
    choices: []
    hasImpact: 1
  - speakerName: 
    text: "\u0412\u0447\u0435\u0440\u0430 \u0440\u0435\u0431\u0451\u043D\u043E\u043A
      \u0441 \u043F\u044F\u0442\u043E\u0433\u043E \u044D\u0442\u0430\u0436\u0430
      \u0434\u043E\u0442\u0440\u043E\u043D\u0443\u043B\u0441\u044F \u0434\u043E \u043C\u0435\u043D\u044F
      \u2014 \u0438 \u043D\u0430 \u0440\u0443\u043A\u0435 \u043E\u0441\u0442\u0430\u043B\u0441\u044F
      \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u044B\u0439 \u0441\u043B\u0435\u0434."
    isPlayer: 1
    isThought: 0
    choices: []
    hasImpact: 1
  - speakerName: 
    text: "\u0422\u0430\u043A\u043E\u0439 \u0436\u0435, \u043A\u0430\u043A \u043D\u0430
      \u0441\u0442\u0435\u043D\u0435. "
    isPlayer: 1
    isThought: 0
    choices: []
    hasImpact: 1
  - speakerName: "\u0418\u0432\u0430\u043D\u043E\u0432"
    text: "\u0412\u043E\u0442 \u043C\u0435\u043B\u043A\u0438\u0439 \u0433\u0430\u0434!
      \u042F \u0435\u043C\u0443 \u043F\u043E\u043A\u0430\u0436\u0443!"
    isPlayer: 0
    isThought: 0
    choices: []
    hasImpact: 1
  - speakerName: 
    text: "\u042D\u0442\u043E\u0442 \u0434\u0435\u0434 \u043D\u0435\u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u044B\u0439."
    isPlayer: 1
    isThought: 1
    choices: []
    hasImpact: 1
  - speakerName: 
    text: "\u041D\u0435 \u043D\u0430\u0434\u043E. \u042F \u0441\u0430\u043C\u0430
      \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u044E. "
    isPlayer: 1
    isThought: 0
    choices: []
    hasImpact: 1
  - speakerName: 
    text: "\u0425\u043E\u0447\u0443 \u043F\u043E\u043D\u044F\u0442\u044C, \u0447\u0442\u043E
      \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442."
    isPlayer: 1
    isThought: 0
    choices: []
    hasImpact: 1
  - speakerName: "\u0418\u0432\u0430\u043D\u043E\u0432"
    text: "\u041B\u0430\u0434\u043D\u043E \u0443\u0436."
    isPlayer: 0
    isThought: 0
    choices: []
    hasImpact: 1
