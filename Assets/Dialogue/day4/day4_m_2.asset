MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f678bb307374424aa5463d934b9f5e2, type: 3}
  m_Name: day4_m_2
  m_EditorClassIdentifier: 
  lines:
  - speakerName: "\u0411\u0430\u0431\u0443\u0448\u043A\u0430 \u041D\u0438\u043D\u0430"
    text: "\u041D\u0430 \u0440\u0430\u0431\u043E\u0442\u0443 \u0438\u0434\u0435\u0448\u044C? "
    isPlayer: 0
    isThought: 0
    choices: []
  - speakerName: 
    text: 
    isPlayer: 0
    isThought: 0
    choices:
    - choiceText: "\u0414\u0430"
      dialogueLines:
      - speakerName: 
        text: "\u0414\u0430, \u043D\u0430 \u044D\u0442\u043E\u0439 \u043D\u0435\u0434\u0435\u043B\u0435
          \u044F \u0431\u0435\u0437 \u0432\u044B\u0445\u043E\u0434\u043D\u044B\u0445."
        isPlayer: 1
        isThought: 0
        choices: []
      - speakerName: "\u0411\u0430\u0431\u0443\u0448\u043A\u0430 \u041D\u0438\u043D\u0430"
        text: "\u041A\u0430\u043A\u043E\u0439 \u0443\u0436\u0430\u0441, \u043A\u0430\u043A
          \u0442\u043E\u0433\u0434\u0430 \u043E\u0442\u0434\u044B\u0445\u0430\u0442\u044C? "
        isPlayer: 0
        isThought: 0
        choices: []
    - choiceText: "\u042D\u0442\u043E \u0432\u044B \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438
        \u0437\u0430\u043F\u0438\u0441\u043A\u0443 \u0432 \u043B\u0438\u0444\u0442\u0435?"
      dialogueLines:
      - speakerName: 
        text: "\u0412 \u043B\u0438\u0444\u0442\u0435 \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C
          \u0437\u0430\u043F\u0438\u0441\u043A\u0438, \u044D\u0442\u043E \u0432\u044B
          \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442\u0435 \u0438\u0445? "
        isPlayer: 1
        isThought: 0
        choices: []
      - speakerName: "\u0411\u0430\u0431\u0443\u0448\u043A\u0430 \u041D\u0438\u043D\u0430"
        text: "\u041A\u0430\u043A \u0442\u044B \u0434\u043E\u0433\u0430\u0434\u0430\u043B\u0430\u0441\u044C?
          \u0412\u0447\u0435\u0440\u0430 \u0443\u0432\u0438\u0434\u0435\u043B\u0430,
          \u043A\u0430\u043A \u043A\u0442\u043E-\u0442\u043E \u043E\u0441\u0442\u0430\u0432\u0438\u043B
          \u0437\u0430\u043F\u0438\u0441\u043A\u0443, \u0440\u0435\u0448\u0438\u043B\u0430
          \u0442\u043E\u0436\u0435 \u0442\u0430\u043A \u043F\u0440\u0438\u0432\u043B\u0435\u0447\u044C
          \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435."
        isPlayer: 0
        isThought: 0
        choices: []
      - speakerName: "\u0411\u0430\u0431\u0443\u0448\u043A\u0430 \u041D\u0438\u043D\u0430"
        text: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438, \u0432\u043E \u0447\u0442\u043E
          \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u0441\u044F \u043D\u0430\u0448
          \u043F\u043E\u0434\u044A\u0435\u0437\u0434! \u0412\u0435\u0437\u0434\u0435
          \u043C\u0443\u0441\u043E\u0440! "
        isPlayer: 0
        isThought: 0
        choices: []
