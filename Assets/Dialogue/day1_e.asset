    - choiceText: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F"
      nextLineIndex: 5
  - speakerName: 
    text: "\u041A\u0430\u043A\u0430\u044F \u043C\u0438\u043B\u0430\u044F \u0431\u0430\u0431\u0443\u043B\u044F"
    isPlayer: 1
    isThought: 1
