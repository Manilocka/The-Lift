  - speakerName: "\u0411\u0410\u0411\u0423\u0428\u041A\u0410 \u041D\u0418\u041D\u0410"
    text: "\u0412\u043E\u0437\u044C\u043C\u0438, \u0434\u0435\u0442\u043E\u0447\u043A\u0430,
      \u0441 \u0440\u0430\u0431\u043E\u0442\u044B \u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C
