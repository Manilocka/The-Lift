  lines:
  - speakerName: 
    text: "> \u0421\u0435\u0440\u0433\u0435\u0439 \u041C. \u0431\u044B\u043B \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u043D
      \u0432 \u0442\u043E\u0442 \u0436\u0435 \u0432\u0435\u0447\u0435\u0440 \u043F\u0440\u0438
      \u043F\u043E\u043F\u044B\u0442\u043A\u0435 \u0441\u043A\u0440\u044B\u0442\u044C\u0441\u044F."
    isPlayer: 0
    isThought: 0
    choices: []
    hasImpact: 0
  - speakerName: 
    text: "> \u041F\u0440\u0438 \u043E\u0431\u044B\u0441\u043A\u0435 \u0432 \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0435
      \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u044B \u043C\u043D\u043E\u0433\u043E\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u044B\u0435
      \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
      \u0435\u0433\u043E \u043F\u0440\u0435\u0441\u0442\u0443\u043F\u043D\u043E\u0439
      \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438."
    isPlayer: 0
    isThought: 0
    choices: []
    hasImpact: 0
  - speakerName: 
    text: "> \u041C\u0430\u043B\u044C\u0447\u0438\u043A \u0414\u0438\u043C\u0430
      \u0431\u044B\u043B \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D \u0432
      \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0443 \u0441 \u043C\u043D\u043E\u0433\u043E\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u044B\u043C\u0438
      \u0442\u0440\u0430\u0432\u043C\u0430\u043C\u0438 \u0438 \u043F\u0440\u0438\u0437\u043D\u0430\u043A\u0430\u043C\u0438
      \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043F\u0441\u0438\u0445\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
      \u0438 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u043D\u0430\u0441\u0438\u043B\u0438\u044F."
    isPlayer: 0
    isThought: 0
    choices: []
    hasImpact: 0
  - speakerName: 
    text: "> \u042D\u043A\u0441\u043F\u0435\u0440\u0442\u0438\u0437\u0430 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043B\u0430,
      \u0447\u0442\u043E \u0432\u0441\u0435 \u043A\u0430\u0440\u0430\u043A\u0443\u043B\u0438
      \u0432 \u043B\u0438\u0444\u0442\u0435 \u0431\u044B\u043B\u0438 \u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u044B
      \u0438\u043C \u0432 \u043F\u043E\u043F\u044B\u0442\u043A\u0435 \u043F\u043E\u0437\u0432\u0430\u0442\u044C
      \u043D\u0430 \u043F\u043E\u043C\u043E\u0449\u044C. "
    isPlayer: 0
    isThought: 0
    choices: []
    hasImpact: 0
  - speakerName: 
    text: "> \u041D\u0438\u043D\u0430 \u0410\u0440\u043A\u0430\u0434\u044C\u0435\u0432\u043D\u0430
      \u043F\u043E\u0445\u043E\u0440\u043E\u043D\u0435\u043D\u0430 \u043D\u0430 \u043C\u0435\u0441\u0442\u043D\u043E\u043C
      \u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0435. "
    isPlayer: 0
    isThought: 0
    choices: []
    hasImpact: 0
  - speakerName: 
    text: "> \u0420\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A\u043E\u0432
      \u043D\u0435 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u043E.
      \u041D\u0430 \u043F\u043E\u0445\u043E\u0440\u043E\u043D\u0430\u0445 \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0438
      \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043E\u0441\u0435\u0434\u0438."
    isPlayer: 0
    isThought: 0
    choices: []
    hasImpact: 0
  - speakerName: 
    text: "> \u042F \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u043B\u0430 \u0432
      \u0434\u0440\u0443\u0433\u043E\u0439 \u0440\u0430\u0439\u043E\u043D. \u0413\u043E\u0432\u043E\u0440\u044F\u0442,
      \u0437\u0434\u0435\u0441\u044C \u0445\u043E\u0440\u043E\u0448\u0430\u044F \u0437\u0432\u0443\u043A\u043E\u0438\u0437\u043E\u043B\u044F\u0446\u0438\u044F."
    isPlayer: 0
    isThought: 0
    choices: []
    hasImpact: 0
  - speakerName: 
    text: "> \u041D\u043E \u044F \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440
      \u043D\u0435 \u043C\u043E\u0433\u0443 \u0438\u0437\u0431\u0430\u0432\u0438\u0442\u044C\u0441\u044F
      \u043E\u0442 \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0438 \u043F\u0440\u0438\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u0442\u044C\u0441\u044F
      \u043A \u0437\u0432\u0443\u043A\u0430\u043C \u0437\u0430 \u0441\u0442\u0435\u043D\u043E\u0439. "
    isPlayer: 0
    isThought: 0
    choices: []
    hasImpact: 0
  - speakerName: 
    text: "> \u0418\u043D\u043E\u0433\u0434\u0430 \u0441\u0430\u043C\u044B\u0435
      \u0441\u0442\u0440\u0430\u0448\u043D\u044B\u0435 \u043C\u043E\u043D\u0441\u0442\u0440\u044B
      \u043D\u0435 \u043F\u0440\u044F\u0447\u0443\u0442\u0441\u044F \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435."
    isPlayer: 0
    isThought: 0
    choices: []
    hasImpact: 0
  - speakerName: 
    text: "> \u041E\u043D\u0438 \u0436\u0438\u0432\u0443\u0442 \u043F\u043E \u0441\u043E\u0441\u0435\u0434\u0441\u0442\u0432\u0443.
      \u0418 \u043D\u043E\u0441\u044F\u0442 \u043E\u0431\u044B\u0447\u043D\u044B\u0435
      \u043B\u0438\u0446\u0430. "
    isPlayer: 0
    isThought: 0
    choices: []
    hasImpact: 0
  - speakerName: 
    text: "> \u0410 \u043C\u044B \u0441\u0430\u043C\u0438 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043C\u0441\u044F
      \u0438\u0445 \u0441\u043E\u043E\u0431\u0449\u043D\u0438\u043A\u0430\u043C\u0438
      \u2014 \u0441\u0442\u043E\u0438\u0442 \u043D\u0430\u043C \u043B\u0438\u0448\u044C
      \u043E\u0442\u0432\u0435\u0441\u0442\u0438 \u0432\u0437\u0433\u043B\u044F\u0434
      \u0438 \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0432\u0438\u0434, \u0447\u0442\u043E
      \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442. "
    isPlayer: 0
    isThought: 0
    choices: []
    hasImpact: 1
