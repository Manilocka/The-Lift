  lines:
  - speakerName: "C\u0435\u0440\u0433\u0435\u0439"
    text: "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E! \u0414\u0438\u043C\u0430,
      \u043F\u043E\u0437\u0434\u043E\u0440\u043E\u0432\u0430\u0439\u0441\u044F."
    isPlayer: 0
    isThought: 0
    choices: []
    hasImpact: 1
  - speakerName: "\u0414\u0438\u043C\u0430"
    text: ...
    isPlayer: 0
    isThought: 0
    choices: []
    hasImpact: 1
  - speakerName: "\u0421\u0435\u0440\u0433\u0435\u0439"
    text: "\u0418\u0437\u0432\u0438\u043D\u0438\u0442\u0435, \u043E\u043D \u0443
      \u043C\u0435\u043D\u044F \u0441\u0442\u0435\u0441\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439...
      \u0421 \u0442\u0435\u0445 \u043F\u043E\u0440 \u043A\u0430\u043A \u043C\u0430\u043C\u0430
      \u043D\u0430\u0441 \u0431\u0440\u043E\u0441\u0438\u043B\u0430, \u043E\u043D
      \u043F\u043E\u0447\u0442\u0438 \u043D\u0435 \u0440\u0430\u0437\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0442."
    isPlayer: 0
    isThought: 0
    choices: []
    hasImpact: 1
  - speakerName: 
    text: 
    isPlayer: 0
    isThought: 0
    choices:
    - choiceText: "\u041F\u043E\u0437\u0434\u043E\u0440\u043E\u0432\u0430\u0442\u044C\u0441\u044F
        \u0441 \u0440\u0435\u0431\u0435\u043D\u043A\u043E\u043C"
      dialogueLines:
      - speakerName: 
        text: "\u041F\u0440\u0438\u0432\u0435\u0442, \u0414\u0438\u043C\u0430!"
        isPlayer: 1
        isThought: 0
        choices: []
        hasImpact: 1
      - speakerName: "\u0414\u0438\u043C\u0430"
        text: ...
        isPlayer: 1
        isThought: 0
        choices: []
        hasImpact: 1
    - choiceText: "\u041C\u043E\u043B\u0447\u0430\u0442\u044C"
      dialogueLines:
      - speakerName: 
        text: "\u041D\u0435 \u0445\u043E\u0447\u0443 \u0440\u0430\u0437\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044C"
        isPlayer: 1
        isThought: 1
        choices: []
        hasImpact: 1
    hasImpact: 1
